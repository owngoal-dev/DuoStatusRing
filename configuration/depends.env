# depends.env — package Depends, by fact (hook-lib-depends).
#
# The firmware FLOOR is MIN_IOS in build.env, not here. This file holds only the
# substrate-provider list and an optional firmware ceiling, per scheme.
# package-deb.sh derives preferenceloader (prefs bundle shipped), uikittools (an
# .app ships) and launchctl (a LaunchDaemons plist ships) from the staged tree.
#
# The provider defaults to the virtual id mobilesubstrate. Use a concrete
# provider (ellekit) only when a device shows the virtual id is not provided;
# record "Depends verified: <provider> on <iOS version>" in AGENTS.md.

# Space-separated providers per scheme. May be empty (a tweak that hooks nothing
# through a provider needs none — this template resolves MSHook* via dlsym and
# lists mobilesubstrate only as the conventional provider dependency).
PROVIDERS_ROOTHIDE=mobilesubstrate
PROVIDERS_ROOTLESS=mobilesubstrate

# Optional firmware ceiling per scheme, e.g. "16.7.10". Empty means no ceiling.
CEILING_ROOTHIDE=
CEILING_ROOTLESS=
