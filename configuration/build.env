# build.env — the one place the author configures this tweak. Every value here
# is read by the scripts; nothing is retyped. Fill the placeholder values once when
# you instantiate the repo (a single find/replace), then edit as needed.
#
# Placeholder values are author-filled at instantiation. The packager tokens
# (@PREFIX@ @VERSION@ @ARCHITECTURE@ @INSTALLED_SIZE@ @PACKAGE_ID@ @MIN_IOS@
# @DEPENDS@) are substituted later by scripts/package-deb.sh and never appear
# here.

# The dylib and filter-plist base name, e.g. MyTweak -> MyTweak.dylib.
TWEAK_NAME=DuoStatusRing

# The Debian package id. package-deb.sh reads this to fill control's @PACKAGE_ID@.
PACKAGE_ID=wiki.qaq.duostatusring

# Deployment floor. Feeds the compile flag, both control files, the audit and
# the depiction. Default 15.0; never below 14.0 (arm64e lifts minos to 14.0).
MIN_IOS=16.0

# The SDK the tweak is compiled against.
#   TWEAK_SDK=xcode          the Xcode iphoneos SDK (default; no PrivateFrameworks)
#   TWEAK_SDK=<path>         a custom sysroot, e.g. a Theos sdks/iPhoneOS*.sdk,
#                            used as data. Switch to one only after a probe shows
#                            the Xcode SDK is missing a needed framework
#                            (Preferences is one — the prefs bundle needs it).
# TWEAK_SDK source: which SDK the value points at, for the record.
TWEAK_SDK=xcode
TWEAK_SDK_SOURCE="Xcode iphoneos SDK"

# Preferences bundle sysroot. The Xcode SDK has no Preferences framework, so a
# prefs bundle needs an SDK that ships PrivateFrameworks stubs. Defaults to
# TWEAK_SDK when that already has Preferences; otherwise point it at such an SDK
# (a Theos sdks/iPhoneOS*.sdk). Only used when src/prefs/ exists.
PREFS_SDK=

# The pinned custom SDK (ci-pin-and-verify-inputs). Every custom path that
# TWEAK_SDK or PREFS_SDK points at must match this pin, or build-ios.sh fails;
# the Xcode SDK is never pinned here. CI fetches exactly this SDK from
# SDK_SOURCE_REPO at SDK_SOURCE_REF (sparse, SDK_SOURCE_PATH only) outside the
# work tree. The defaults are a Theos sdks iPhoneOS16.5.sdk, used as data.
#
# SDK_VERSION: what the SDK REPORTS in SDKSettings.json, not its directory name
#   (a Theos iPhoneOS16.5.sdk reports 16.4).
# SDK_DIGEST_METHOD: git-tree-id (the SDK dir's git tree object; build-ios.sh
#   recomputes it from the files) or sorted-file-sha256 (sha256 of the sorted
#   "<path> <sha256|-> <target>" manifest, symlink targets included).
# SDK_DIGEST_VALUE: the recorded digest.
SDK_VERSION=16.4
SDK_DIGEST_METHOD=git-tree-id
SDK_DIGEST_VALUE=81466d46b666daa04ae3d2b0b9d5324f0f621359
SDK_SOURCE_REPO=https://github.com/theos/sdks.git
SDK_SOURCE_REF=0222fd5413cf4b9af096f37b4621afa2688572f7
SDK_SOURCE_PATH=iPhoneOS16.5.sdk

# Directory holding the pinned official MIT roothide.h (used by the roothide
# scheme). Vendored under stubs/roothide by default so the build is
# self-contained; CI uses the same vendored copy.
ROOTHIDE_HEADER_DIR=stubs/roothide

# The optional privileged helper's launchd label. Empty means no helper: then
# src/helper/ is not built and no LaunchDaemons plist ships.
HELPER_LABEL=

# The Mach service the helper vends (only used when HELPER_LABEL is set).
HELPER_SERVICE=
